{
  "name": "WellFit Project Rail",
  "version": "1.0.0",
  "status": "active_control_contract",
  "updated": "2026-08-15",
  "purpose": "Provide one non-duplicating control plane over the existing WellFit planning, task, agent, review, readiness and work-log systems so every idea is planned, built, verified, documented and followed through without losing open work.",
  "principle": "This register does not replace AGENTS.md, TODO files, runtime truth, task queues or project registers. It links them and defines the mandatory end-to-end transition contract.",
  "authoritative_sources": {
    "rules": "AGENTS.md",
    "runtime_state": "docs/status/WELLFIT_RUNTIME_STATE_2026-07-24.md",
    "owner_truth": "project-register/wellfit-beta1-canonical-truth.json",
    "current_project_state": "todolist/CURRENT_PROJECT_STATE.md",
    "work_map": "todolist/WORK_MAP.md",
    "todo_index": "todolist/TODO_INDEX.md",
    "next_actions": "todolist/NEXT_ACTIONS.md",
    "open_done_list": "todolist/MASTER_OPEN_DONE_LIST.md",
    "done_log": "todolist/DONE_LOG.md",
    "task_queue": "project-register/agent-task-queue.json",
    "control_center": "project-register/agent-control-center.json",
    "work_log": "project-register/agent-work-log.json",
    "progress_log": "project-register/progress-log.json",
    "continuity": "project-register/continuity-dependency-map.json",
    "readiness": "project-register/product-readiness.json",
    "definition_of_done": "project-register/definition-of-done.json",
    "risk": "project-register/risk-classifier.json",
    "pr_review": "project-register/pr-review-policy.json",
    "post_pr_guard": "project-register/pr-post-creation-guard.json"
  },
  "lifecycle": {
    "ordered_states": [
      "idea",
      "analysis",
      "owner_decision_if_required",
      "planned",
      "ready",
      "in_progress",
      "testing",
      "review",
      "pr_created",
      "merged",
      "verified",
      "done"
    ],
    "side_states": ["blocked", "deferred", "rejected"],
    "no_skip_rule": true,
    "done_rule": "A task is done only after merge, required checks, post-merge verification, documentation/register synchronization and capture of all follow-up work.",
    "agent_claims_finished_are_not_done": true
  },
  "planning_gate": {
    "required_before_ready": true,
    "required_fields": [
      "task_id",
      "problem",
      "goal",
      "scope",
      "non_goals",
      "dependencies",
      "allowed_paths",
      "blocked_paths",
      "risk_level",
      "owner_decision_required",
      "required_checks",
      "rollback_or_stop_plan",
      "definition_of_done",
      "expected_follow_up_sources"
    ],
    "protected_or_high_risk_requires_owner_approval": true,
    "missing_field_action": "blocked"
  },
  "dispatcher_contract": {
    "may_select_next_task_when": [
      "task_state_is_ready",
      "dependencies_are_satisfied",
      "no_conflicting_active_file_ownership",
      "required_owner_decision_is_present",
      "risk_policy_allows_execution"
    ],
    "must_reserve": ["task_id", "branch", "allowed_paths", "file_ownership"],
    "must_not": [
      "create_parallel_architecture",
      "silently_change_owner_truth",
      "start_blocked_or_deferred_work",
      "start_conflicting_hotspot_work",
      "self_approve",
      "merge_or_deploy_without_policy_authority"
    ]
  },
  "completion_sync": {
    "required_after_merge": true,
    "must_reconcile": [
      "todolist/CURRENT_PROJECT_STATE.md",
      "todolist/NEXT_ACTIONS.md",
      "todolist/MASTER_OPEN_DONE_LIST.md",
      "todolist/DONE_LOG.md",
      "project-register/agent-task-queue.json",
      "project-register/agent-work-log.json",
      "project-register/progress-log.json",
      "project-register/continuity-dependency-map.json",
      "project-register/product-readiness.json"
    ],
    "must_capture": [
      "merged_pr",
      "commit_sha",
      "changed_files",
      "checks_and_results",
      "verified_behavior",
      "known_limitations",
      "new_follow_ups",
      "next_safe_tasks",
      "owner_decisions_created_or_resolved"
    ],
    "automatic_done_without_sync": false
  },
  "parallel_work": {
    "allowed": true,
    "requires_non_overlapping_file_ownership": true,
    "requires_dependency_check": true,
    "hotspots_are_serial_by_default": [
      "AGENTS.md",
      "todolist/CURRENT_PROJECT_STATE.md",
      "todolist/NEXT_ACTIONS.md",
      "todolist/TODO_INDEX.md",
      "project-register/agent-task-queue.json",
      "project-register/agent-control-center.json",
      "project-register/project-rail.json",
      "firestore.rules",
      "functions/index.js",
      "package.json",
      "package-lock.json"
    ]
  },
  "owner_attention": {
    "surface_only_when": [
      "owner_decision_required",
      "protected_scope_approval_required",
      "external_dependency_or_credential_required",
      "risk_or_scope_changed",
      "tests_or_verification_cannot_be_completed",
      "merge_or_release_gate_requires_human_action"
    ],
    "do_not_interrupt_for": [
      "routine_analysis",
      "low_risk_documentation_sync",
      "normal test execution",
      "known non-blocking follow_up_capture"
    ]
  },
  "dashboard_contract": {
    "initial_form": "generated_markdown_or_json_summary",
    "future_ui_optional": true,
    "required_sections": [
      "goal",
      "current_phase",
      "progress",
      "in_progress",
      "ready_next",
      "blocked",
      "owner_decisions",
      "open_prs",
      "failed_checks",
      "recently_done",
      "next_safe_parallel_batch"
    ]
  },
  "current_scope": {
    "goal": "Stable adult invite-only Closed Beta that Gerhard can test end-to-end as a normal user.",
    "beta_boundary": "No blockchain, token, NFT, cash-out, real-money wallet transfer, public marketplace, Mayor or Reality Glitch activation.",
    "currency_migration": "WFXP/WFP/XP remains owner-decision-blocked; no autonomous rename or migration.",
    "landing_page_parallel_work": "Landing-page work may continue independently. Project-rail work must not modify landing-page runtime files."
  }
}
